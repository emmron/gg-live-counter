# Owner login password for /admin (dev falls back to "admin" if unset)
ADMIN_PASSWORD=change-me

# Long random string used to sign the login cookie, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Upstash Redis. Adding Upstash from the Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN
# automatically. Either pair works. Leave both unset locally to use an in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: comma-separated public IPs that get the owner view without logging in.
# Careful: customers on the cafe wifi share the same public IP.
ADMIN_IPS=
